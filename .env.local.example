# Copy this file to .env.local and fill in your machine's LAN IP to test the
# app from a phone or other device on the same local network.
# See README.md > "Testing on your local network" for details.

# Your machine's LAN IP (e.g. `ipconfig getifaddr en0` on macOS Wi-Fi).
# Lets the Next.js dev server accept requests from that origin instead of
# only localhost.
NEXT_DEV_ALLOWED_ORIGIN=192.168.1.7

# Base URL the browser uses to call the admin API. Must use the same LAN IP
# so a phone can reach it — the default localhost:4000 only resolves on this
# machine.
NEXT_PUBLIC_ADMIN_API_URL=http://192.168.1.7:4000

# Origin the admin API's CORS allows. Must match the LAN URL the Next app is
# served from.
ADMIN_ALLOWED_ORIGIN=http://192.168.1.7:3000
